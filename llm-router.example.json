{
  // ==========================================================================
  // opencode-llm-router — example configuration (JSONC: comments allowed)
  //
  // Copy to:   ~/.config/opencode/llm-router.json        (global)
  //       or   <project>/.opencode/llm-router.json       (per project)
  //
  // GOOD NEWS: you probably don't need this file at all. The defaults are
  // DYNAMIC — every route is an { auto } selector resolved against YOUR live
  // opencode catalog (zen free models, Go catalog, anything you connect).
  // Model lists rotate? The router re-resolves every time. Nothing rots.
  //
  // This file documents every knob. Delete what you don't touch.
  // ==========================================================================

  // "suggest" shows what it WOULD route (safe evaluation) · "auto" reroutes · "off" disables
  "mode": "auto",

  // Routing only happens in these agents. Default ["auto-router"]: Tab to the
  // "auto-router" mode (a build clone) to use it. Set [] to route EVERY agent.
  "onlyAgents": ["auto-router"],

  // Show a TUI toast on each decision · respect explicit model variant picks
  "notify": true,
  "respectVariant": true,

  // Winner's normalized vote share needed to reroute (below: keep your model)
  "minConfidence": 0.4,

  // -------------------------------------------------------------------------
  // ROUTES — category -> target. Three ways to point at models:
  //
  //   "opencode/big-pickle"                          exact model
  //   ["opencode-go/kimi-k3", "opencode/big-pickle"] fallback chain
  //   { "model": { "auto": { ... } } }               dynamic selector (default)
  //   "keep"                                         never change the model
  //
  // Selector fields: prefer (ordered regexes over id+name), freeOnly,
  // providers (priority order), vision, minContext, pick (first|largest|smallest)
  // Add "params" to any object route for sampling overrides.
  // -------------------------------------------------------------------------
  "routes": {
    "trivial": { "model": { "auto": { "freeOnly": true, "prefer": ["nano", "mini", "flash", "pickle"] } } },
    "simple": { "model": { "auto": { "freeOnly": true } } },
    "code": { "model": { "auto": { "providers": ["opencode-go", "opencode"], "prefer": ["code", "kimi", "glm"] } } },
    "reasoning": {
      "model": { "auto": { "providers": ["opencode-go", "opencode"], "prefer": ["k3", "ultra", "max", "pro"] } },
      "params": { "temperature": 0.1 }
    },
    "creative": { "model": { "auto": { "providers": ["opencode-go", "opencode"], "prefer": ["plus", "pro", "qwen"] } } },
    "vision": { "model": { "auto": { "vision": true } } },
    "agentic": { "model": { "auto": { "providers": ["opencode-go", "opencode"], "prefer": ["code", "kimi"] } } },
    "long_context": { "model": { "auto": { "pick": "largest" } } },

    // PII/credentials detected -> routed here. Free zen models are still
    // CLOUD models; for real privacy use a local one, e.g. "ollama/qwen3:8b".
    "private": { "model": { "auto": { "freeOnly": true } } }
  },

  // -------------------------------------------------------------------------
  // THE SMALL AI — classifies ambiguous prompts. By default it runs on a
  // model from YOUR opencode catalog (source "opencode") — no API keys, no
  // external calls beyond what opencode already does.
  // -------------------------------------------------------------------------
  "classifier": {
    "enabled": true,
    "source": "opencode",
    "model": { "auto": { "freeOnly": true, "prefer": ["nano", "mini", "flash", "pickle"] } },
    "when": "uncertain", // only call it when heuristics disagree
    "weight": 2,
    "timeoutMs": 6000,
    "cacheTtlMinutes": 60

    // --- Advanced: raw OpenAI-compatible endpoint instead (Ollama, OpenRouter…)
    // "source": "endpoint",
    // "baseURL": "http://localhost:11434/v1",
    // "apiKey": "ollama",
    // "model": "qwen3:4b"
  },

  // -------------------------------------------------------------------------
  // SIGNALS
  // -------------------------------------------------------------------------
  "signals": {
    "complexity": { "enabled": true, "weight": 1 },
    "taskType": { "enabled": true, "weight": 1 },
    "contextLength": { "enabled": true, "weight": 1, "longChars": 24000 },
    "toolsNeeded": { "enabled": true, "weight": 1 },

    "pii": { "enabled": true, "action": "route", "route": "private" },

    "rules": {
      "enabled": true,
      "weight": 3,
      "list": [
        // veto rules beat every other signal
        { "name": "prod-guard", "match": "\\b(production|prod)\\b.*\\b(deploy|migration)\\b", "route": "reasoning", "veto": true },
        { "name": "k8s", "match": "kubernetes|helm", "route": "code" }
      ]
    },

    // Optional local BERT zero-shot classifier (needs: npm i @huggingface/transformers)
    "bert": { "enabled": false, "model": "Xenova/distilbert-base-uncased-mnli", "weight": 1.5 },

    // Your own signal plugins: modules exporting (ctx) => ({ votes, reason } | { veto } | null)
    "custom": { "enabled": true, "weight": 1, "paths": [] }
  },

  // Decision audit log (JSONL, never contains prompt text)
  "log": { "enabled": true },
  "debug": false
}
